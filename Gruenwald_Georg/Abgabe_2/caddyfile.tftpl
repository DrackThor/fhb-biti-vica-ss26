{
  email ${admin_email}
}

${stats_domain} {
  # Allow the API Docs domain to fetch the Swagger JSON
  header {
      Access-Control-Allow-Origin "https://${api_domain}"
      Access-Control-Allow-Methods "GET, OPTIONS"
  }
  reverse_proxy localhost:19999
}

${api_domain} {
  reverse_proxy localhost:8080
}
